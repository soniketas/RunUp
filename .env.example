# Copiá este archivo a .env.local para desarrollo local con `vercel dev`
# (no lo uses con `npm run dev` de Vite solo — ese no corre las funciones de /api).
#
# En producción, configurá esta misma variable en:
# Vercel → Project → Settings → Environment Variables

# API key de https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: fija el modelo de visión a usar. Si lo dejás vacío, el código usa
# un default razonable, pero confirmá el id de modelo con soporte de visión
# vigente en https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=
