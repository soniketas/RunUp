# Copiá este archivo a .env.local para desarrollo local con `vercel dev`
# (no lo uses con `npm run dev` de Vite solo — ese no corre las funciones de /api).
#
# En producción, configurá esta misma variable en:
# Vercel → Project → Settings → Environment Variables

# API key de https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: fija el modelo de visión a usar. Si lo dejás vacío, el código usa
# un default razonable, pero confirmá el id de modelo con soporte de visión
# vigente en https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=

# Config del proyecto de Firebase (Firestore) que sincroniza el stock entre
# dispositivos. Sacala de: Firebase Console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration.
# Estas vars llevan el prefijo VITE_ porque las lee el cliente (Vite las
# expone al bundle en build time) — no son secretas en el sentido de una API
# key de servidor, son la config pública de un proyecto de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: id del bar (MVP soporta uno solo, pero queda parametrizado).
# Default si se deja vacío: "default".
VITE_BAR_ID=
